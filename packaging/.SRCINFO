pkgbase = nstream
	pkgdesc = Native, terminal-first Stremio-like client (Cinemeta + Torrentio/debrid or local P2P + mpv)
	pkgver = 1.20.0
	pkgrel = 1
	url = https://github.com/gianlucamazza/nstream
	install = nstream.install
	arch = any
	license = MIT
	checkdepends = python-pytest
	makedepends = git
	makedepends = python-build
	makedepends = python-installer
	makedepends = python-wheel
	makedepends = python-hatchling
	depends = python
	depends = mpv
	depends = fzf
	depends = ffmpeg
	optdepends = foot: terminal used by the desktop launcher
	optdepends = catt: cast to a Chromecast with --cast (install via pipx; not in the repos)
	optdepends = chafa: poster thumbnails in the fzf preview pane
	optdepends = torrserver-bin: local P2P playback without a debrid provider (AUR)
	optdepends = libva-utils: GPU decode detection (vainfo) for hardware-aware stream ranking
	source = nstream::git+ssh://git@github.com/gianlucamazza/nstream.git#tag=v1.20.0
	sha256sums = SKIP

