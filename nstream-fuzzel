#!/usr/bin/env bash
# Fuzzel-driven entry for nstream: prompt for a title, then run the fzf TUI in foot.
set -euo pipefail
q=$(: | fuzzel --dmenu --prompt "guarda> " --lines 0) || exit 0
[ -n "$q" ] || exit 0
# Keep the terminal open if nstream exits non-zero, so messages like
# "nessuno stream disponibile" stay readable instead of vanishing with the window.
exec foot -T nstream sh -c \
  'nstream "$1"; ec=$?; [ "$ec" -ne 0 ] && { printf "\n[nstream] uscita codice %s — INVIO per chiudere.\n" "$ec"; read -r _; }; exit "$ec"' \
  nstream "$q"
